PORT=3001
# demo is fully offline. Set to openai after supplying your own key.
AGENT_MODE=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional: omit to use persistent SQLite (Node 24).
DATABASE_URL=
# Enable on hosted PostgreSQL deployments to reject accidental SQLite fallback.
REQUIRE_POSTGRES=false
SQLITE_PATH=data/relay.sqlite
# Legacy v1 cookie migration key. V2 opaque sessions are persisted in the database.
# Preserve an existing value during migration; never rotate it to fix a database issue.
SESSION_SECRET=
# Set true only behind HTTPS in production.
COOKIE_SECURE=false
# Exact browser origin for writes. Default permits same-origin requests.
APP_ORIGIN=
