PORT=3001
# demo is fully offline. Set to openai after supplying your own key.
AGENT_MODE=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional: omit to use persistent SQLite (Node 24).
DATABASE_URL=
SQLITE_PATH=data/relay.sqlite
# Set a long random value before deploying; persistent sessions depend on it.
SESSION_SECRET=
# Set true only behind HTTPS in production.
COOKIE_SECURE=false
# Exact browser origin for writes. Default permits same-origin requests.
APP_ORIGIN=
